<UserControl x:Class="Flow.Launcher.Plugin.Snippets.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="400">
    <StackPanel Margin="{DynamicResource SettingPanelMargin}">
        <TextBlock Text="Snippets Plugin Settings"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Color05B}"
                   Margin="{DynamicResource SettingPanelItemTopBottomMargin}"/>
        <TextBlock Text="Manage and organize your snippets in a versioned JSON library."
                   FontSize="13"
                   Foreground="{DynamicResource Color04B}"
                   Margin="{DynamicResource SettingPanelItemTopBottomMargin}"
                   TextWrapping="Wrap"/>
        <!-- Action Groups -->
        <StackPanel Orientation="Horizontal" Margin="{DynamicResource SettingPanelItemTopBottomMargin}">
            <!-- Group 1: Manage Snippets -->
            <Button x:Name="ManageSnippetsButton"
                    Content="Manage Snippets"
                    Padding="16,6"
                    Click="ManageSnippetsButton_Click"/>

            <!-- Visual Separation -->
            <Border Width="1"
                    Height="20"
                    Margin="32,0,32,0"
                    Background="{DynamicResource Color03B}"
                    VerticalAlignment="Center"/>

            <!-- Group 2: Backup / Restore (Export & Import) -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ExportButton"
                        Content="Export JSON"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Click="ExportButton_Click"/>
                <Button x:Name="ImportButton"
                        Content="Import JSON"
                        Padding="16,6"
                        Click="ImportButton_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
