<Window x:Class="Flow.Launcher.Plugin.Snippets.Views.SnippetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Snippets"
        Height="600" Width="960"
        MinHeight="480" MinWidth="760"
        Background="{DynamicResource Color01B}"
        Foreground="{DynamicResource Color05B}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manage Snippets" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Color05B}"/>
            <TextBlock Text="View, search, and manage your snippet library." FontSize="12" Foreground="{DynamicResource Color04B}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main 2-Column Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search & Snippet List Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Color00B}"
                    BorderBrush="{DynamicResource Color03B}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar & New Action -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterBox"
                                 Grid.Column="0"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 KeyboardNavigation.TabIndex="0"
                                 AutomationProperties.Name="Filter snippets by key"
                                 TextChanged="FilterBox_TextChanged"/>
                        <Button x:Name="ClearFilterButton"
                                Grid.Column="1"
                                Content="Clear"
                                Margin="6,0,0,0"
                                Padding="10,4"
                                KeyboardNavigation.TabIndex="1"
                                AutomationProperties.Name="Clear filter"
                                Click="ClearFilterButton_Click"/>
                        <Button x:Name="NewSnippetButton"
                                Grid.Column="2"
                                Content="New"
                                Margin="6,0,0,0"
                                Padding="12,4"
                                KeyboardNavigation.TabIndex="2"
                                AutomationProperties.Name="New snippet"
                                Click="NewSnippetButton_Click"/>
                    </Grid>

                    <!-- List Column Header -->
                    <Grid Grid.Row="1" Margin="6,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Color04B}"/>
                        <TextBlock Grid.Column="1" Text="Preview" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Color04B}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Score" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Color04B}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Snippets ListBox & Composed Empty State -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="SnippetsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Single"
                                 IsTabStop="True"
                                 KeyboardNavigation.TabIndex="3"
                                 AutomationProperties.Name="Snippets list"
                                 SelectionChanged="SnippetsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Color02B}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Color02B}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BasicSystemAccentColor}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BasicSystemAccentColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Color05B}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource Color04B}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}" FontSize="12" Foreground="{DynamicResource Color04B}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Composed Empty State -->
                        <StackPanel x:Name="EmptyStateContainer"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="EmptyStateIcon"
                                       Text="&#xE7C3;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="28"
                                       Foreground="{DynamicResource Color04B}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="EmptyStateTitle" Text="No snippets found" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Color05B}"/>
                            <TextBlock x:Name="EmptyStateDescription" Text="Add a new snippet using the editor." FontSize="11" Foreground="{DynamicResource Color04B}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Editor Card -->
            <Border x:Name="EditorCard"
                    Grid.Column="2"
                    Background="{DynamicResource Color00B}"
                    BorderBrush="{DynamicResource Color03B}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="FormHeader" Text="New snippet" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Color05B}"/>
                        <TextBlock Text="Configure shortcut key, priority score, and snippet content." FontSize="11" Foreground="{DynamicResource Color04B}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Scrollable Editor Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <!-- Key and Score fields -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Key" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Color05B}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="KeyBox"
                                             Padding="8,5"
                                             MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             KeyboardNavigation.TabIndex="4"
                                             AutomationProperties.Name="Snippet key"/>
                                    <TextBlock Text="Unique snippet trigger name" FontSize="11" Foreground="{DynamicResource Color04B}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Score" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Color05B}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ScoreBox"
                                             Text="0"
                                             Padding="8,5"
                                             MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             KeyboardNavigation.TabIndex="5"
                                             AutomationProperties.Name="Snippet score"/>
                                    <TextBlock Text="Priority ranking" FontSize="11" Foreground="{DynamicResource Color04B}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Value field -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Value" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Color05B}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ValueBox"
                                         MinHeight="140"
                                         Padding="8,6"
                                         AcceptsReturn="True"
                                         AcceptsTab="False"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         KeyboardNavigation.TabIndex="6"
                                         AutomationProperties.Name="Snippet value"/>
                                <TextBlock Text="Multiline content inserted when triggered" FontSize="11" Foreground="{DynamicResource Color04B}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Inline Error Banner -->
                    <Border x:Name="ErrorContainer"
                            Grid.Row="2"
                            Background="{DynamicResource Color02B}"
                            BorderBrush="{DynamicResource Color10B}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="{DynamicResource Color10B}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   AutomationProperties.Name="Editor error"/>
                    </Border>

                    <!-- Fixed Action Footer -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button x:Name="AddButton"
                                Content="Add snippet"
                                Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                KeyboardNavigation.TabIndex="7"
                                AutomationProperties.Name="Add snippet"
                                Click="AddButton_Click"/>
                        <Button x:Name="SaveButton"
                                Content="Save changes"
                                Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                KeyboardNavigation.TabIndex="8"
                                AutomationProperties.Name="Save changes"
                                Visibility="Collapsed"
                                Click="SaveButton_Click"/>
                        <Button x:Name="DeleteButton"
                                Content="Delete"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                KeyboardNavigation.TabIndex="9"
                                AutomationProperties.Name="Delete snippet"
                                Foreground="{DynamicResource Color10B}"
                                Visibility="Collapsed"
                                Click="DeleteButton_Click"/>
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Padding="16,6"
                                KeyboardNavigation.TabIndex="10"
                                AutomationProperties.Name="Cancel"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
